{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-01-01",
  // Serve the Vite build output as a static site (no Worker script needed).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
